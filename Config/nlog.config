<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <targets>
        <!--
          pixelrp: the console target is wrapped in AsyncWrapper. Console writes
          take a process-wide lock and, under Docker, go straight to the
          json-file log pipe — a synchronous, blocking write. Logging from the
          game-cycle thread or from inside a room's ProcessRoom therefore spent
          TICK TIME on I/O. The wrapper hands writes to a background thread;
          overflowAction="Discard" means a log burst drops lines instead of
          stalling the hotel, which is the correct trade for a game loop.
        -->
        <target name="asyncConsole" xsi:type="AsyncWrapper" overflowAction="Discard" queueLimit="10000" timeToSleepBetweenBatches="0">
            <target name="console" xsi:type="ColoredConsole" layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:${newline}${exception:format=tostring}}" useDefaultRowHighlightingRules="true" />
        </target>
    </targets>

    <rules>
        <!--
          pixelrp: Info, not Trace. GameClient logs one DEBUG line per OUTGOING
          PACKET, so at Trace a busy room produced a continuous synchronous
          write stream. Program.cs applies PLUS_LOG_LEVEL over this at startup,
          so debugging is an env var and a restart, not a rebuild.
        -->
        <logger name="*" minlevel="Info" writeTo="asyncConsole" />
    </rules>
</nlog>
